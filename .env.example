# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored and must never be committed.

NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Enable the WebGL hero once the 3D scene lands (docs/3D-INTEGRATION.md).
# Off by default — the SVG cinematic fallback renders instead.
NEXT_PUBLIC_HERO_3D=0
